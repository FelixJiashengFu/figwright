# Figwright reads keys from its settings file (written by the Settings page or by
# `figwright config set-key`) and, failing that, from the environment. Copy this
# file to `.env`, fill in the one or two providers you actually use, and load it
# before starting: `set -a && . ./.env && set +a && figwright`.
#
# A key is never needed to try Figwright: with none set it runs in offline demo
# mode, drawing from text rules instead of a model, and says so on every figure.

# --- text models: these turn a description into a figure -----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
TOKENHUB_API_KEY=
QIANFAN_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- anything else that speaks the OpenAI API ---------------------------------
# Set the address on the Settings page; it is saved to ~/.figwright/config.json
# under providers.custom.base_url.
FIGWRIGHT_CUSTOM_API_KEY=

# Ollama and LM Studio run on your own machine and need no key at all:
#   ollama serve            (http://localhost:11434/v1)
#   LM Studio local server  (http://localhost:1234/v1)

# --- where Figwright keeps its things -----------------------------------------
# Settings, projects and version history (default: ~/.figwright)
# FIGWRIGHT_HOME=
# Where the command line and the MCP server write finished files (default: ~/Figwright)
# FIGWRIGHT_OUTPUT_DIR=
# Access token, only needed with `figwright serve --allow-remote`
# FIGWRIGHT_TOKEN=
